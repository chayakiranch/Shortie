# Existing required settings
MONGODB_URL=your-mongodb-connection-string
DATABASE_NAME=shortie
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
SHORTIE_BASE_URL=http://127.0.0.1:8000

# Google OAuth web client
GOOGLE_CLIENT_ID=your-google-web-client-id
GOOGLE_CLIENT_SECRET=your-google-web-client-secret

# Password reset email (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-sender@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
FRONTEND_BASE_URL=https://YOUR-FRONTEND-RENDER-DOMAIN

# Use independent, randomly generated secrets (at least 32 characters each).
# API_KEY_PEPPER is required for creating and authenticating API keys.
API_KEY_PEPPER=replace-with-a-dedicated-random-secret
# WEBHOOK_SECRET_PEPPER derives signing secrets and is required to register webhooks.
WEBHOOK_SECRET_PEPPER=replace-with-a-different-random-secret

# Webhook worker controls; values are bounded by the application.
WEBHOOK_WORKER_POLL_SECONDS=2
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_REQUEST_TIMEOUT_SECONDS=8
WEBHOOK_WORKER_CONCURRENCY=4
